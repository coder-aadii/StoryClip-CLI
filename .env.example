GEMINI_API_KEY=your_google_ai_studio_key
PEXELS_API_KEY=your_pexels_api_key
JAMENDO_CLIENT_ID=your_jamendo_client_id
# Change model identifiers if your account supports different models.
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Local multilingual Whisper model for matching Gemini audio to visual scenes.
STORYCLIP_ALIGN_MODEL=small
# Local VoiceStudio service configuration (models stored in /home/rails/Work/AI-Models)
VOICESTUDIO_URL=http://127.0.0.1:38123
VOICESTUDIO_SPEED=1.15
# Cloudflare Workers AI configuration (for --image-provider cloudflare-flux / flux)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
